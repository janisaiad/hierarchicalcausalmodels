\@writefile{toc}{\contentsline {subsection}{\numberline {A.1}\textsc  {Confondant} : transformation complète}{24}{subsection.A.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {\textsc  {Confondant} : transformations complètes.} (a)~HCM original avec plaques. (b)~Modèle collapsé : $Q^a_i$ et $Q^{y|a}_i$ sont deux variables aléatoires confondues par $U_i$. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche = fonction déterministe) avec parents $Q^a_i$ et $Q^{y|a}_i$. (d)~Modèle marginalisé : identique à l'augmenté ici, car la positivité est satisfaite. Le do-calcul sur (c)/(d) identifie $\mathrm  {p}(Q^y \,\vert \,\mathrm  {do}(Q^a = q^a_\star )) = \mathbb  {E}_{Q^{y|a}}[\DOTSB \sum@ \slimits@ _a q^a_\star (a)\,Q^{y|a}(a)]$.}}{24}{figure.caption.7}\protected@file@percent }
\newlabel{fig:app_confounder}{{6}{24}{\textbf {\textsc {Confondant} : transformations complètes.} (a)~HCM original avec plaques. (b)~Modèle collapsé : $Q^a_i$ et $Q^{y|a}_i$ sont deux variables aléatoires confondues par $U_i$. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche = fonction déterministe) avec parents $Q^a_i$ et $Q^{y|a}_i$. (d)~Modèle marginalisé : identique à l'augmenté ici, car la positivité est satisfaite. Le do-calcul sur (c)/(d) identifie $\pr (Q^y \g \rmdo (Q^a = q^a_\star )) = \mathbb {E}_{Q^{y|a}}[\sum _a q^a_\star (a)\,Q^{y|a}(a)]$}{figure.caption.7}{}}
\newlabel{fig:app_confounder@cref}{{[figure][6][2147483647]6}{[1][24][]24}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.2}\textsc  {Confondant et Interférence} : transformation complète}{24}{subsection.A.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {\textsc  {Confondant et Interférence} : transformations complètes.} (a)~HCM original : $A_{ij}$ agrège vers $Z_i$ (interférence), $U_i$ confond $A_{ij}$ et $Y_{ij}$. (b)~Modèle collapsé : structure de porte avant $Q^a_i \to Z_i \to Q^{y|a}_i$, avec $U_i$ confondant $Q^a_i$ et $Q^{y|a}_i$ mais pas $Z_i$. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche) avec parents $Q^a_i$ et $Q^{y|a}_i$ ; le médiateur $Z_i$ est la clé de l'identification via la porte avant. La formule obtenue est : $\mathrm  {p}(Q^y \mid \mathrm  {do}(Q^a{=}q^a_\star )) = \DOTSB \sum@ \slimits@ _{z} \mathrm  {p}(Q^{y|a} \mid Z{=}z)\tmspace  +\thickmuskip {.2777em}\mathrm  {p}(Z{=}z \mid Q^a{=}q^a_\star )$.}}{24}{figure.caption.8}\protected@file@percent }
\newlabel{fig:app_interfere}{{7}{24}{\textbf {\textsc {Confondant et Interférence} : transformations complètes.} (a)~HCM original : $A_{ij}$ agrège vers $Z_i$ (interférence), $U_i$ confond $A_{ij}$ et $Y_{ij}$. (b)~Modèle collapsé : structure de porte avant $Q^a_i \to Z_i \to Q^{y|a}_i$, avec $U_i$ confondant $Q^a_i$ et $Q^{y|a}_i$ mais pas $Z_i$. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche) avec parents $Q^a_i$ et $Q^{y|a}_i$ ; le médiateur $Z_i$ est la clé de l'identification via la porte avant. La formule obtenue est : $\pr (Q^y \mid \mathrm {do}(Q^a{=}q^a_\star )) = \sum _{z} \pr (Q^{y|a} \mid Z{=}z)\;\pr (Z{=}z \mid Q^a{=}q^a_\star )$}{figure.caption.8}{}}
\newlabel{fig:app_interfere@cref}{{[figure][7][2147483647]7}{[1][24][]24}}
\providecommand\NAT@force@numbers{}\NAT@force@numbers
\@writefile{toc}{\contentsline {subsection}{\numberline {A.3}\textsc  {Instrument} : transformation complète}{25}{subsection.A.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {\textsc  {Instrument} : transformations complètes.} (a)~HCM original : $Z_{ij}$ instrument sous-unité, $A_{ij}$ traitement sous-unité, $Y_i$ résultat unité ; $U_i$ confond $A_{ij}$ et $Y_i$ mais est indépendant de $Z_{ij}$. (b)~Modèle collapsé : $Z_{ij}$ et $A_{ij}$ deviennent $Q^z_i$ et $Q^{a|z}_i$ ; $U_i$ confond $Q^{a|z}_i$ et $Y_i$, mais $Q^z_i$ reste non confondant. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche) avec parents $Q^{a|z}_i$ et $Q^z_i$ ; $Q^y_i$ n'est pas directement identifiable car $Q^z_i$ viole la positivité, ce qui nécessite la marginalisation. (d)~Modèle marginalisé : suppression de $Q^z_i$ ; sur ce graphe le do-calcul (Règle~2) s'applique directement. La formule identifiée est : $\mathrm  {p}(Y \mid \mathrm  {do}(A{\sim }q^a_\star )) = \mathbb  {E}_{Q^{a|z},Q^z}\!\bigl  [\frac  {q^a_\star (a)}{Q^{a|z}(a\mid z)}\,Y\bigr  ]$.}}{25}{figure.caption.9}\protected@file@percent }
\newlabel{fig:app_instrument}{{8}{25}{\textbf {\textsc {Instrument} : transformations complètes.} (a)~HCM original : $Z_{ij}$ instrument sous-unité, $A_{ij}$ traitement sous-unité, $Y_i$ résultat unité ; $U_i$ confond $A_{ij}$ et $Y_i$ mais est indépendant de $Z_{ij}$. (b)~Modèle collapsé : $Z_{ij}$ et $A_{ij}$ deviennent $Q^z_i$ et $Q^{a|z}_i$ ; $U_i$ confond $Q^{a|z}_i$ et $Y_i$, mais $Q^z_i$ reste non confondant. (c)~Modèle augmenté : ajout de $Q^y_i$ (double flèche) avec parents $Q^{a|z}_i$ et $Q^z_i$ ; $Q^y_i$ n'est pas directement identifiable car $Q^z_i$ viole la positivité, ce qui nécessite la marginalisation. (d)~Modèle marginalisé : suppression de $Q^z_i$ ; sur ce graphe le do-calcul (Règle~2) s'applique directement. La formule identifiée est : $\pr (Y \mid \mathrm {do}(A{\sim }q^a_\star )) = \mathbb {E}_{Q^{a|z},Q^z}\!\bigl [\frac {q^a_\star (a)}{Q^{a|z}(a\mid z)}\,Y\bigr ]$}{figure.caption.9}{}}
\newlabel{fig:app_instrument@cref}{{[figure][8][2147483647]8}{[1][24][]25}}
