\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Heavy-tail Q-Q diagnostics for Reading ($Y$) and Mathematics ($M$). The standardized Q-Q plots and GPD tail zooms show departures from a global Gaussian approximation in the score extremes.}}{6}{figure.caption.7}\protected@file@percent }
